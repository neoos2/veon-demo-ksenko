---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import FutureLink from "./FutureLink.astro";
import { contacts } from "../data/site";

const anchors = [
  { href: "#directions", label: "Напрями" },
  { href: "#brands", label: "Бренди" },
  { href: "#service", label: "Сервіс" },
  { href: "#contacts", label: "Контакти" },
];
---
<header class="header" data-header>
  <div class="container header__bar">
    <a class="header__logo" href="#hero" aria-label="КСЕНКО — на початок сторінки"><Logo /></a>

    <nav class="header__nav" aria-label="Головне меню" data-rec="UX-R07">
      <ul class="header__links">
        {anchors.map((a) => <li><a class="header__link" href={a.href}>{a.label}</a></li>)}
        <li><FutureLink class="header__link header__link--future">Про компанію</FutureLink></li>
      </ul>
      <p class="lang" aria-label="Мова сайту">
        <span class="lang__current" aria-current="true">UK</span>
        <span class="lang__sep" aria-hidden="true">/</span>
        <FutureLink class="lang__other future-link--end" note="Англійська версія в розробці"><span lang="en">EN</span></FutureLink>
      </p>
    </nav>

    <a class="header__phone" href={contacts.sales.href} data-rec="UX-R02">
      <span class="header__phone-num">{contacts.sales.label}</span>
      <span class="header__phone-dept">{contacts.sales.dept}</span>
    </a>

    <div class="header__compact">
      <a class="icon-btn" href={contacts.sales.href} aria-label={`Зателефонувати у ${contacts.sales.dept.toLowerCase()}: ${contacts.sales.label}`}><Icon name="phone" size={22} /></a>
      <button class="icon-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
        <Icon name="menu" size={24} /><span class="visually-hidden">Відкрити меню</span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Меню" hidden data-menu>
    <div class="container menu__inner">
      <div class="menu__top">
        <a class="header__logo" href="#hero" aria-label="КСЕНКО — на початок сторінки" data-menu-close-link><Logo /></a>
        <button class="icon-btn" type="button" data-menu-close><Icon name="close" size={24} /><span class="visually-hidden">Закрити меню</span></button>
      </div>
      <ul class="menu__links">
        {anchors.map((a) => <li><a class="menu__link" href={a.href} data-menu-close-link>{a.label}</a></li>)}
        <li><FutureLink class="menu__link">Про компанію</FutureLink></li>
      </ul>
      <p class="lang lang--menu" aria-label="Мова сайту">
        <span class="lang__current" aria-current="true">UK</span>
        <span class="lang__sep" aria-hidden="true">/</span>
        <FutureLink class="lang__other" note="Англійська версія в розробці"><span lang="en">EN</span></FutureLink>
      </p>
      <ul class="menu__contacts">
        <li><a class="menu__phone" href={contacts.sales.href}><span class="menu__phone-num">{contacts.sales.label}</span><span class="menu__phone-dept">{contacts.sales.dept}</span></a></li>
        <li><a class="menu__phone" href={contacts.office.href}><span class="menu__phone-num">{contacts.office.label}</span><span class="menu__phone-dept">{contacts.office.dept}, у т. ч. сервіс</span></a></li>
        <li><a class="text-link" href={contacts.email.href}>{contacts.email.address}</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: var(--z-nav); background: var(--color-bg); transition: box-shadow var(--dur-short) var(--ease-out); }
  .header.is-scrolled { box-shadow: 0 1px 0 var(--color-border), 0 4px 12px var(--color-shade); }
  .header__bar { display: flex; align-items: center; gap: var(--space-lg); min-height: var(--header-h); }
  .header__logo { display: inline-flex; color: var(--color-text); padding-block: var(--space-xs); }
  .header__nav, .header__phone { display: none; }
  .header__compact { margin-left: auto; display: flex; gap: var(--space-xs); }

  .icon-btn { display: inline-grid; place-items: center; width: 48px; height: 48px; padding: 0; border: var(--line) solid var(--color-line); border-radius: var(--radius); background: transparent; color: var(--color-text); cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out); }
  .icon-btn:hover { background: var(--color-surface); }
  .icon-btn:active { transform: scale(.98); }
  .header__compact .icon-btn:first-child { background: var(--color-accent); border-color: var(--color-accent); }
  .header__compact .icon-btn:first-child:hover { background: var(--color-accent-hover); }

  .header__links { display: flex; align-items: center; gap: var(--space-xs); }
  .header__link { display: inline-flex; align-items: center; min-height: 44px; padding-inline: var(--space-sm); font-size: 1rem; text-decoration: none; color: var(--color-text); text-underline-offset: 0.35em; }
  a.header__link:hover { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-brand); }
  :global(.header__link--future) { color: var(--color-text-muted); }

  .lang { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: 1rem; font-stretch: var(--narrow); }
  .lang__current { font-weight: var(--w-head); padding-inline: var(--space-2xs); }
  .lang__sep { color: var(--color-line); }
  :global(.lang__other) { min-height: 44px; padding-inline: var(--space-2xs); }

  .header__phone { flex-direction: column; align-items: flex-end; margin-left: auto; padding: var(--space-2xs) 0; text-decoration: none; color: var(--color-text); line-height: 1.2; }
  .header__phone-num { font-size: 1.125rem; font-weight: var(--w-brand); font-stretch: var(--wide); white-space: nowrap; }
  .header__phone-dept { font-size: var(--text-sm); font-stretch: var(--narrow); color: var(--color-text-muted); }
  .header__phone:hover .header__phone-num { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-accent); text-underline-offset: 0.2em; }

  @media (min-width: 76rem) {
    .header__nav { display: flex; align-items: center; gap: var(--space-lg); margin-left: var(--space-xl); }
    .header__phone { display: flex; }
    .header__compact { display: none; }
  }

  /* Full-screen menu (390–1150) */
  .menu { position: fixed; inset: 0; z-index: var(--z-menu); background: var(--color-surface); overflow-y: auto; }
  .menu[hidden] { display: none; }
  .menu__inner { display: grid; gap: var(--space-xl); padding-bottom: var(--space-2xl); }
  .menu__top { display: flex; align-items: center; justify-content: space-between; min-height: var(--header-h); }
  .menu__links { display: grid; border-top: var(--line) solid var(--color-border); }
  .menu__links li { border-bottom: var(--line) solid var(--color-border); }
  :global(.menu__link) { display: flex; align-items: center; min-height: 60px; font-size: var(--text-title); font-weight: var(--w-head); font-stretch: var(--wide); text-decoration: none; color: var(--color-text); }
  :global(.future-link.menu__link) { color: var(--color-text-muted); font-weight: var(--w-text); }
  .menu__contacts { display: grid; gap: var(--space-lg); }
  .menu__phone { display: grid; text-decoration: none; color: var(--color-text); }
  .menu__phone-num { font-size: var(--text-title); font-weight: var(--w-brand); font-stretch: var(--wide); }
  .menu__phone-dept { font-size: var(--text-sm); color: var(--color-text-muted); }
  @media (min-width: 76rem) { .menu { display: none !important; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");

  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (menu && openBtn && closeBtn) {
    const focusables = () => Array.from(menu.querySelectorAll<HTMLElement>("a[href], button, [tabindex='0']"));
    const open = () => {
      menu.hidden = false;
      openBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    };
    const close = (restore = true) => {
      menu.hidden = true;
      openBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      if (restore) openBtn.focus();
    };
    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", () => close());
    menu.querySelectorAll("[data-menu-close-link]").forEach((a) => a.addEventListener("click", () => close(false)));
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { e.preventDefault(); close(); return; }
      if (e.key !== "Tab") return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    window.matchMedia("(min-width: 76rem)").addEventListener("change", (m) => { if (m.matches && !menu.hidden) close(false); });
  }
</script>
