---
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { contacts } from "../data/site";
const pages = ["Каталог", "Бренди", "Сервіс", "Про компанію", "Календар-2026", "Політика конфіденційності"];
const year = 2026;
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__logo" href="#hero" aria-label="КСЕНКО — на початок сторінки"><Logo /></a>
      <p class="footer__line">Офіційний дистриб’ютор медичного обладнання з 2002 року.</p>
    </div>

    <ul class="footer__contacts" data-rec="UX-R02,S-R008">
      <li><a class="footer__phone" href={contacts.sales.href}>{contacts.sales.label}</a><span class="footer__dept">{contacts.sales.dept}</span></li>
      <li><a class="footer__phone" href={contacts.office.href}>{contacts.office.label}</a><span class="footer__dept">{contacts.office.dept}</span></li>
      <li><a class="text-link" href={contacts.email.href}>{contacts.email.address}</a></li>
      <li><address>{contacts.address}</address></li>
    </ul>

    <nav class="footer__nav" aria-label="Розділи сайту">
      <ul>
        {pages.map((p) => (
          <li><FutureLink class="future-link--up" rec={p === "Календар-2026" ? "UX-R07" : undefined}>{p}</FutureLink></li>
        ))}
        <li><a class="text-link" href={contacts.facebook} rel="noopener" target="_blank">Facebook<span class="visually-hidden"> (відкриється в новій вкладці)</span></a></li>
      </ul>
    </nav>

    <p class="footer__legal">© {year} {contacts.legal}</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-footer); padding-block: var(--space-2xl) var(--space-xl); font-size: 1rem; }
  .footer__grid { display: grid; gap: var(--space-xl); }
  .footer__logo { display: inline-flex; color: var(--color-text); }
  .footer__line { margin-top: var(--space-md); color: var(--color-text-muted); max-width: 30ch; }
  .footer__contacts { display: grid; gap: var(--space-md); }
  .footer__contacts li { display: grid; }
  .footer__phone { color: var(--color-text); text-decoration: none; font-weight: var(--w-brand); font-stretch: var(--wide); white-space: nowrap; }
  .footer__phone:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .footer__dept { font-size: var(--text-sm); color: var(--color-text-muted); }
  .footer__nav ul { display: grid; gap: var(--space-xs); }
  .footer__nav li { display: flex; }
  .footer__nav :global(.future-link), .footer__nav a { min-height: 32px; }
  .footer__legal { font-size: var(--text-sm); color: var(--color-text-muted); padding-top: var(--space-lg); border-top: var(--line) solid var(--color-border); }

  @media (min-width: 60rem) {
    .footer__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); }
    .footer__brand { grid-column: 1 / 5; }
    .footer__contacts { grid-column: 5 / 9; }
    .footer__nav { grid-column: 9 / 13; }
    .footer__legal { grid-column: 1 / 13; }
  }
  @media (max-width: 40rem) { .footer { padding-bottom: calc(var(--space-xl) + var(--bar-h) + env(safe-area-inset-bottom)); } }
</style>
