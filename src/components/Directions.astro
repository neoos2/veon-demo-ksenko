---
import { Picture } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import { contacts, directions } from "../data/site";
---
<section id="directions" class="section directions" aria-labelledby="directions-title">
  <div class="container">
    <div class="directions__head">
      <h2 id="directions-title">10 напрямів медичного обладнання</h2>
      <p class="directions__lead">Ціни й комплектації — у відділі продажів: <a class="text-link directions__phone" href={contacts.sales.href}>{contacts.sales.label}</a></p>
    </div>

    <ol class="directions__list" data-rec="UX-R04">
      {directions.map((d, i) => (
        <li class="directions__item">
          <FutureLink class="dir" note="Розділ каталогу в розробці">
            <span class="dir__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="dir__body">
              <span class="dir__name">{d.name}</span>
              {d.model && <span class="dir__model">{d.model}</span>}
            </span>
            <span class:list={["dir__media", { "dir__media--framed": d.framed, "dir__media--empty": !d.img }]}>
              {d.img && (
                <Picture
                  src={d.img}
                  alt={d.alt ?? ""}
                  widths={[64, 128, 240]}
                  sizes="(min-width: 40rem) 128px, 64px"
                  formats={["avif", "webp"]}
                  loading="lazy"
                  decoding="async"
                  class="dir__img"
                />
              )}
            </span>
          </FutureLink>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .directions__head { display: grid; gap: var(--space-md); margin-bottom: var(--space-xl); }
  .directions__head h2 { font-size: var(--text-h2); text-wrap: balance; max-width: 20ch; }
  .directions__lead { color: var(--color-text-muted); max-width: 44ch; }
  .directions__phone { white-space: nowrap; font-weight: var(--w-brand); }

  .directions__list { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--space-2xl); border-top: var(--line) solid var(--color-border); }
  .directions__item { border-bottom: var(--line) solid var(--color-border); min-width: 0; }

  .directions__list :global(.dir) {
    display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) 64px; align-items: center; column-gap: var(--space-sm);
    width: 100%; min-height: 72px; padding-block: var(--space-xs); color: var(--color-text); text-decoration: none;
  }
  .dir__num { font-size: var(--text-sm); font-stretch: var(--narrow); color: var(--color-text-muted); }
  .dir__body { display: grid; gap: var(--space-2xs); min-width: 0; }
  .dir__name { position: relative; justify-self: start; font-size: var(--text-title); font-weight: var(--w-head); font-stretch: var(--wide); line-height: 1.15; overflow-wrap: break-word; min-width: 0; }
  .dir__name::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 2px; background: var(--color-text); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-short) var(--ease-out); }
  .dir__model { font-size: var(--text-sm); font-stretch: var(--narrow); color: var(--color-text-muted); line-height: 1.3; }
  .dir__media { display: flex; align-items: flex-end; justify-content: center; height: 56px; }
  .dir__media :global(picture) { display: block; mix-blend-mode: multiply; transition: transform var(--dur-short) var(--ease-out), opacity var(--dur-short) var(--ease-out); }
  .dir__media :global(img) { width: auto; height: auto; max-height: 56px; max-width: 64px; object-fit: contain; }
  .dir__media--framed :global(picture) { mix-blend-mode: normal; }
  .dir__media--framed :global(img) { width: 64px; height: 43px; max-height: none; object-fit: cover; }

  /* Motion 4: the row answers hover and focus; the note says the section is not built yet. */
  @media (hover: hover) {
    .dir__media :global(picture) { opacity: .7; transform: translateX(-8px); }
    .directions__list :global(.dir:hover) .dir__media :global(picture),
    .directions__list :global(.dir:focus-visible) .dir__media :global(picture) { opacity: 1; transform: none; }
  }
  .directions__list :global(.dir:hover) .dir__name::after,
  .directions__list :global(.dir:focus-visible) .dir__name::after { transform: scaleX(1); }
  .directions__list :global(.dir) :global(.future-link__note) { left: calc(2.25rem + var(--space-sm)); top: calc(100% - var(--space-xs)); }

  @media (max-width: 40rem) {
    .directions__list :global(.dir) { grid-template-columns: 1.75rem minmax(0, 1fr) 48px; min-height: 64px; }
    .dir__name { font-size: clamp(1.0625rem, 5vw, 1.25rem); font-stretch: 100%; }
    .dir__model { display: none; }
    .dir__media { height: 44px; }
    .dir__media :global(img) { max-height: 44px; max-width: 48px; }
    .dir__media--framed :global(img) { width: 48px; height: 32px; }
    .directions__list :global(.dir) :global(.future-link__note) { left: calc(1.75rem + var(--space-sm)); }
  }
  @media (min-width: 40rem) {
    .directions__list :global(.dir) { grid-template-columns: 3rem minmax(0, 1fr) 128px; min-height: 136px; column-gap: var(--space-md); }
    .dir__media { height: 112px; }
    .dir__media :global(img) { max-height: 112px; max-width: 128px; }
    .dir__media--framed :global(img) { width: 128px; height: 85px; }
    .directions__list :global(.dir) :global(.future-link__note) { left: calc(3rem + var(--space-md)); }
  }

  @media (min-width: 60rem) {
    .directions__head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); align-items: end; margin-bottom: var(--space-2xl); }
    .directions__head h2 { grid-column: 1 / 8; }
    .directions__lead { grid-column: 8 / 13; }
    .directions__list { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); grid-auto-flow: column; border-top: 0; }
    .directions__item:nth-child(1), .directions__item:nth-child(6) { border-top: var(--line) solid var(--color-border); }
  }
</style>
