---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { cities, contacts } from "../data/site";
---
<section id="service" class="service" aria-labelledby="service-title" data-rec="UX-R03,GA-R002,MA-R005" data-reveal="clip">
  <div class="container service__grid">
    <h2 id="service-title" class="service__title">Сервісна служба: 92&nbsp;% ремонтів — на місці</h2>

    <div class="service__main">
      <p class="service__figure">92&nbsp;%</p>
      <p class="service__figure-text">ремонтів інженери КСЕНКО виконують у приміщенні лікувального закладу, без відправлення апарата в сервісний центр.</p>
    </div>

    <div class="service__side">
      <p class="service__people">21 інженер</p>
      <p class="service__cities-label">Представництва сервісної служби</p>
      <ul class="service__cities" data-rec="UX-R09">
        {cities.map((c) => <li>{c}</li>)}
      </ul>
      <p class="service__regions">Сервісні інженери закріплені за всіма областями України.</p>
      <div class="service__actions">
        <a class="btn btn--ink" href={contacts.office.href} data-rec="UX-R02">
          <Icon name="phone" size={22} />
          <span class="btn__text"><span class="btn__main">{contacts.office.label}</span><span class="btn__sub">{contacts.office.dept}, у т. ч. сервіс</span></span>
        </a>
        <FutureLink class="service__future" note="Сторінка сервісу в розробці">Контакти інженерів за регіонами</FutureLink>
      </div>
    </div>
  </div>
</section>

<style>
  .service { background: var(--color-brand); color: var(--color-text); padding-block: var(--section-pad); }
  .service__grid { display: grid; gap: var(--space-xl); }
  .service__title { font-size: var(--text-h2); text-wrap: balance; max-width: 22ch; }
  .service__main { display: grid; gap: var(--space-md); align-content: start; }
  .service__figure { font-size: var(--text-figure); font-weight: var(--w-hero-figure); font-stretch: var(--wider); line-height: 0.9; letter-spacing: -0.02em; white-space: nowrap; }
  .service__figure-text { font-size: var(--text-title); font-weight: var(--w-brand); line-height: 1.3; max-width: 26ch; }
  .service__side { display: grid; gap: var(--space-md); align-content: start; }
  .service__people { font-size: var(--text-h2); text-wrap: balance; font-weight: var(--w-head); font-stretch: var(--wide); line-height: 1.1; }
  .service__cities-label { font-size: var(--text-sm); }
  .service__cities { display: grid; border-top: var(--line) solid var(--color-text); }
  .service__cities li { padding-block: var(--space-xs); border-bottom: var(--line) solid var(--color-text); font-size: var(--text-title); font-weight: var(--w-head); font-stretch: var(--wide); line-height: 1.2; }
  .service__regions { max-width: 34ch; }
  .service__actions .btn, .service__actions .btn span { white-space: nowrap; }
  .service__actions { display: grid; justify-items: start; gap: var(--space-md); margin-top: var(--space-md); }
  .service :global(.future-link) { color: var(--color-text); min-height: 44px; }

  @media (min-width: 60rem) {
    .service__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-2xl); }
    .service__title { grid-column: 1 / 9; }
    .service__main { grid-column: 1 / 8; }
    .service__side { grid-column: 8 / 13; }
    .service__cities li { font-size: var(--text-h2); text-wrap: balance; padding-block: var(--space-sm); }
  }
</style>
