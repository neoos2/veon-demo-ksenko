---
// Functional line icons only (phone, mail, arrow, menu, close), 1.5 px stroke in the text colour.
interface Props { name: "phone" | "mail" | "arrow" | "arrow-down" | "menu" | "close"; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5C10.9 20 4 13.1 3.5 5.1A1.5 1.5 0 0 1 5 3.5Z" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "arrow" && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === "arrow-down" && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {name === "menu" && <path d="M3.5 7h17M3.5 12h17M3.5 17h17" />}
  {name === "close" && <path d="m5.5 5.5 13 13m0-13-13 13" />}
</svg>
<style>.icon { flex-shrink: 0; }</style>
